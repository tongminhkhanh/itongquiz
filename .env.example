# iTongQuiz local configuration

# Public frontend configuration
VITE_WORKERS_API_URL=https://phieu.thitong.site
VITE_FEATURE_GIFT_SHOP_V2=false
# AI quiz V2: explicit blueprint, OCR page preview, progress/cancel.
# Keep false until the rollout checklist is approved.
VITE_FEATURE_AI_QUIZ_V2=false
# Per-question contract registry and exact slot audit. Requires AI quiz V2.
VITE_FEATURE_AI_BLUEPRINT_V3=false
# AI performance rollout. Keep both false until the rollout runbook gate is approved.
VITE_FEATURE_AI_FAST_PATH=false
VITE_FEATURE_AI_DEFER_IMAGES=false
VITE_FEATURE_PARENT_PORTAL_V1=false
VITE_GIFT_SHOP_MODE=api

# Build-only sitemap configuration (never prefixed with VITE_)
SITEMAP_SITE_URL=https://www.thitong.site
SITEMAP_API_URL=
SITEMAP_API_TOKEN=

# Optional local automation credentials. Keep values in .env.local only.
SONLA_EMAIL=
SONLA_PASSWORD=

# Production AI/auth credentials are Cloudflare Worker secrets:
#   JWT_SECRET
#   CLIPROXY_TOKEN
# Provision them with `wrangler secret put`; never expose them through VITE_* variables.
